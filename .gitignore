# See https://help.github.com/articles/ignoring-files/

# Nested fork (separate git repo)
axis-crm-outreach/

# Dependencies
# Matches the directory AND a symlink to one. A trailing slash matches only a
# directory, so a `node_modules` symlink (how a scratch worktree shares one
# install) sailed past this and got committed twice, from two different
# laptops, each time pointing at an absolute path that means nothing anywhere
# else and breaking the build.
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
.next/
out/
build/
dist/

# Environment
.env
.env.*
!.env.example

# Testing
test-results/
playwright-report/
playwright/.cache/
tests/.auth/
.manager-resident-apply-journey/
.playwright-mcp/
coverage/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
*.pem

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Testing / coverage
coverage/
.nyc_output
*.lcov

# Misc
*.log
.eslintcache

# Cursor IDE (local editor settings)
.cursor/settings.json
.cursor/rules/local-agent-branch.mdc
playwright.config.ts

# Capacitor native projects (commit ios/ and android/, ignore build output)
.cap-dev-server
.capacitor/
/ios/App/Pods/
/ios/App/App/public/
/ios/DerivedData/

# fastlane / iOS release artifacts (commit config, ignore output)
/ios/App/build/
/ios/App/fastlane/report.xml
/ios/App/fastlane/README.md
/ios/App/fastlane/test_output/
*.ipa
*.xcarchive
/android/.gradle/
/android/app/src/main/assets/public/
/android/local.properties
/android/.idea/
/android/captures/

# Claude Code local state (worktrees, jobs, plans, memory)
.claude/
.cursor/skills/
.env.local
/ios/App/fastlane/.keys/
/env.local
.env*

# Codex local hooks (absolute graphify path from `graphify codex install`)
.codex/

# E2E get-started test screenshots (local evidence output)
.get-started-evidence/

# OAuth verification screenshots — evidence only, never committed (contains account picker frame)
native-oauth-verification/

# Graphify local knowledge graph (regenerated with `graphify update .`).
# `.graphify/` is the current directory; `graphify-out/` is the pre-0.10 name and
# stays ignored so an older checkout does not start committing one.
.graphify/
graphify-out/

# Lavish plan artifacts (may contain captain screenshots; regenerate with npm run lavish:plan)
.lavish/

# Local Playwright CLI session logs
.playwright-cli/

# Scratch dir for local QA reproduction scripts (see docs/agent-mcp-setup.md).
.qa-tmp/
