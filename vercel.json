{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash scripts/vercel-should-build.sh",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "production": true
    }
  },
  "github": {
    "silent": true
  },
  "crons": [
    {
      "path": "/api/cron/dispatch-reminders",
      "schedule": "15 15 * * *"
    },
    {
      "path": "/api/cron/sync-manual-payments",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/send-move-in-reminders",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/send-payment-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/send-lease-signing-reminders",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/send-scheduled-inbox-messages",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/send-document-expiration-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/sms-pool-topup",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/weekly-rent-reminders",
      "schedule": "45 16 * * *"
    },
    {
      "path": "/api/cron/sms-outbox",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/action-event-deliveries",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/manager-attention-digest",
      "schedule": "0 14 * * *"
    }
  ]
}
