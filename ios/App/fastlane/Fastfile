default_platform(:ios)

# PropLane iOS release automation.
#
# The `beta` lane builds the app and ships it to TestFlight. Signing uses the
# distribution certificate from GitHub Actions secrets plus an App Store
# provisioning profile. CI refreshes the profile via App Store Connect (sigh)
# so entitlements like Sign in with Apple stay in sync; APPLE_PROFILE_BASE64 is
# the fallback when API refresh is unavailable.
#
# Required env (set as GitHub Actions secrets — see .github/workflows/ios-testflight.yml):
#   ASC_KEY_ID              App Store Connect API key id
#   ASC_ISSUER_ID           App Store Connect issuer id
#   ASC_KEY_P8              base64 of the AuthKey_XXXX.p8 file contents
#   APPLE_DIST_P12_BASE64   base64 of the distribution certificate .p12
#   APPLE_DIST_P12_PASSWORD password for the .p12
#   APPLE_PROFILE_BASE64    base64 of the App Store .mobileprovision (fallback)
require "base64"
require "fileutils"
require "plist"
require "shellwords"
require "tmpdir"

APP_IDENTIFIER = "space.proplane.app"
TEAM_ID = "8FH3GVHCZ9"
REQUIRED_PROFILE_ENTITLEMENTS = %w[
  com.apple.developer.applesignin
  aps-environment
].freeze

def profile_plist(path)
  xml = `security cms -D -i #{Shellwords.escape(path)}`
  Plist.parse_xml(xml)
end

def assert_app_store_profile!(profile_data)
  name = profile_data.fetch("Name")
  if profile_data.key?("ProvisionedDevices")
    UI.user_error!(
      "Provisioning profile '#{name}' has ProvisionedDevices — " \
      "this is a development/ad-hoc profile, not App Store distribution.",
    )
  end

  entitlements = profile_data["Entitlements"] || {}
  missing = REQUIRED_PROFILE_ENTITLEMENTS.reject { |key| entitlements.key?(key) }
  return if missing.empty?

  UI.user_error!(
    "Provisioning profile '#{name}' is missing entitlements: #{missing.join(', ')}. " \
    "Enable them on the App ID in Apple Developer, regenerate the App Store profile, " \
    "and update APPLE_PROFILE_BASE64 (or fix App Store Connect API access for sigh).",
  )
end

def install_profile_from_path(path)
  install_provisioning_profile(path: path)
  data = profile_plist(path)
  assert_app_store_profile!(data)
  data.fetch("Name")
end

def refresh_profile_via_api(api_key, fallback_path)
  UI.message("Refreshing App Store provisioning profile via App Store Connect API…")
  sigh(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    force: true,
    skip_install: false,
    adhoc: false,
  )
  path = Actions.lane_context[SharedValues::SIGH_PROFILE_PATH]
  raise "sigh did not return a profile path" unless path && File.exist?(path)

  data = profile_plist(path)
  assert_app_store_profile!(data)
  Actions.lane_context[SharedValues::SIGH_NAME] || data.fetch("Name")
rescue StandardError => e
  UI.important("sigh profile refresh failed (#{e.message}); using APPLE_PROFILE_BASE64")
  install_profile_from_path(fallback_path)
end

platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")

    key_dir = File.expand_path(".keys", __dir__)
    FileUtils.mkdir_p(key_dir)
    key_path = File.join(key_dir, "AuthKey_#{key_id}.p8")
    File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_P8")))

    p12_path = File.join(Dir.tmpdir, "proplane-dist-#{Process.pid}.p12")
    profile_path = File.join(Dir.tmpdir, "proplane-dist-#{Process.pid}.mobileprovision")
    File.binwrite(p12_path, Base64.decode64(ENV.fetch("APPLE_DIST_P12_BASE64")))
    File.binwrite(profile_path, Base64.decode64(ENV.fetch("APPLE_PROFILE_BASE64")))

    setup_ci

    import_certificate(
      certificate_path: p12_path,
      certificate_password: ENV.fetch("APPLE_DIST_P12_PASSWORD"),
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"],
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"],
    )

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
    )

    profile_name = refresh_profile_via_api(api_key, profile_path)
    UI.message("Using provisioning profile: #{profile_name}")

    next_build = (latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 6,
    ).to_i + 1).to_s

    # The marketing version comes from App Store Connect state (the workflow's
    # "Resolve App Store version" step, scripts/ios-app-store-release.mjs
    # --plan-version) so a released train can never reject the upload again.
    # Unset — a local `fastlane beta` — keeps whatever Xcode says.
    marketing_version = ENV["MARKETING_VERSION"].to_s.strip
    unless marketing_version.empty? || marketing_version.match?(/\A\d+(\.\d+){0,2}\z/)
      UI.user_error!("MARKETING_VERSION '#{marketing_version}' is not a dotted version.")
    end
    version_xcargs = marketing_version.empty? ? "" : " MARKETING_VERSION=#{marketing_version}"
    UI.message("Building #{marketing_version.empty? ? "Xcode's marketing version" : marketing_version} (#{next_build})")

    # Manual signing must be scoped to the App target only. Global xcargs would also
    # set PROVISIONING_PROFILE_SPECIFIER on Swift Package dependency targets, which
    # cannot accept a provisioning profile.
    update_code_signing_settings(
      path: "App.xcodeproj",
      targets: ["App"],
      build_configurations: ["Release"],
      use_automatic_signing: false,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      team_id: TEAM_ID,
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build}#{version_xcargs}",
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name,
        },
      },
      output_directory: "build",
      output_name: "PropLane.ipa",
      clean: true,
    )

    upload_to_testflight(
      api_key: api_key,
      # Don't block the CI job waiting for Apple's server-side processing. Group
      # assignment is therefore impossible here (pilot needs a processed build to
      # assign one), so it happens in the workflow's dedicated "Distribute build
      # to internal TestFlight group" step, which waits, assigns, and verifies.
      # Without that step an upload is invisible to every tester.
      skip_waiting_for_build_processing: true,
      # Internal testers only — external testing would require App Review.
      distribute_external: false,
    )

    # Hand the build number to the distribution step. Recomputing "latest build"
    # there would race with a concurrent upload and could distribute the wrong one.
    github_output = ENV["GITHUB_OUTPUT"]
    if github_output && !github_output.empty?
      File.open(github_output, "a") { |file| file.puts("build_number=#{next_build}") }
    end
    UI.success("Uploaded build #{next_build}; it is NOT installable until it is assigned to a tester group.")
  ensure
    File.delete(key_path) if defined?(key_path) && key_path && File.exist?(key_path)
    File.delete(p12_path) if defined?(p12_path) && p12_path && File.exist?(p12_path)
    File.delete(profile_path) if defined?(profile_path) && profile_path && File.exist?(profile_path)
  end
end
